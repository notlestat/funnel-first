---
// The client's conversion-first design system sheet, generated from the brand file.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { recipeGuide, recipes, sections, usesFlow } from '../../system/sections';
import { checkContrast, designerChecks, launchChecks } from '../../system/rules';
import { tokenNames } from '../../system/tokens';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((brand) => ({ params: { brand: brand.id }, props: { brand } }));
}

const { brand } = Astro.props as { brand: CollectionEntry<'brands'> };
const { name, tokens, fontsHref, recipe, layout, content, fictional, strategy, pass } = brand.data;
// Read the reference library only when a section links to it; an empty library is normal in a fresh copy.
const references = Object.values(sections).some((s) => s.referenceIds.length) ? await getCollection('references') : [];
const capture = (await getCollection('captures')).find((c) => c.id === brand.id)?.data;
const evidence = (t: string) => capture?.proposal.tokens[t];
const contrastResults = checkContrast(tokens);
const colours = tokenNames.filter((t) => t.startsWith('color-'));
const checks = launchChecks(brand.data);
const statusLabel = { pass: 'Pass', waiting: 'Waiting', fail: 'Fail' } as const;
const variants: Record<string, string | undefined> = layout;
const guide = recipeGuide[recipe];
const flow = usesFlow(recipe);
const target = flow ? '#flow' : '#capture';
const action = content.hero?.cta ?? content.flow?.questions[0].q ?? '';
const strategyRows = strategy
  ? [
      ['Dream customer', strategy.dream_customer],
      ['Where they are', strategy.where_they_are],
      ['Hook', strategy.hook],
      ['Belief that stops them', strategy.false_belief],
      ['Offer', strategy.offer],
      ['Not for', strategy.not_for],
      ['Second yes', strategy.second_yes ?? 'Not planned yet'],
    ]
  : [];
---

<Base title={`${name} design system`} description={`Conversion-first design system for ${name}.`} tokens={tokens} fontsHref={fontsHref}>
  <main class="container sheet">
    <header>
      <p class="eyebrow">Design system{fictional && ' · fictional sample brand'}</p>
      <h1>{name}</h1>
      <p class="muted">
        Funnel type: {recipe}. {guide.goal} <a href={`/${brand.id}/`}>View the funnel</a>
      </p>
      <p class="muted small">
        Download tokens: <a href={`/${brand.id}/tokens.json`}>JSON (DTCG)</a> · <a href={`/${brand.id}/tokens.css`}>CSS</a>
      </p>
      {
        capture && (
          <p class="muted small">
            Captured from {capture.urls.join(', ')} on {capture.captured_at}. A reconstructed draft: values were read from the
            rendered pages, not from the client's source files.
          </p>
        )
      }
    </header>

    <section aria-labelledby="launch">
      <h2 id="launch">Launch readiness</h2>
      <ul class="checks" role="list">
        {checks.map((c) => <li data-status={c.status}>{statusLabel[c.status]}: {c.label}</li>)}
      </ul>
    </section>

    <section aria-labelledby="strategy">
      <h2 id="strategy">Funnel strategy</h2>
      {
        strategy ? (
          <dl class="strategy">
            {strategyRows.map(([k, v]) => (
              <div>
                <dt class="muted small">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="muted">Not written yet. Add a strategy to the brand file before building the page.</p>
        )
      }
    </section>

    <section aria-labelledby="pass-heading">
      <h2 id="pass-heading">Brunson pass</h2>
      {
        pass ? (
          <>
            <div class="table-wrap">
              <table>
                <caption class="muted">Hook, story and offer on every step. When a step fails, one of the three is wrong.</caption>
                <thead><tr><th scope="col">Step</th><th scope="col">Hook</th><th scope="col">Story</th><th scope="col">Offer</th></tr></thead>
                <tbody>{pass.steps.map((s) => <tr><td><strong>{s.step}</strong></td><td>{s.hook}</td><td>{s.story}</td><td>{s.offer}</td></tr>)}</tbody>
              </table>
            </div>
            <dl class="strategy pass-facts">
              <div><dt class="muted small">Headlines to test</dt><dd><ol>{pass.headline_options.map((h) => <li>{h}</li>)}</ol></dd></div>
              <div><dt class="muted small">The doubt</dt><dd>{pass.doubt.belief}</dd></div>
              <div><dt class="muted small">How the page answers it ({pass.doubt.where} section)</dt><dd>{pass.doubt.answer}</dd></div>
              <div>
                <dt class="muted small">Offer stack</dt>
                <dd><ul>{pass.offer_stack.map((o) => <li>{o.item} <span class="role">{o.status === 'confirmed' ? 'confirmed' : 'ask the client'}</span></li>)}</ul></dd>
              </div>
              {pass.client_questions.length > 0 && (
                <div><dt class="muted small">Questions for the client</dt><dd><ol>{pass.client_questions.map((q) => <li>{q}</li>)}</ol></dd></div>
              )}
            </dl>
          </>
        ) : (
          <p class="muted">Not written yet. Run the brunson-pass skill before this funnel is reviewed. Real client funnels cannot build without it.</p>
        )
      }
      <h3 class="subhead">Designer checks the build cannot make</h3>
      <ul class="designer" role="list">
        {
          designerChecks.map((d) => (
            <li>
              {d.q}
              {pass?.checks[d.id] && <p class="answer">{pass.checks[d.id]}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="colour">
      <h2 id="colour">Colour</h2>
      <ul class="swatches" role="list">
        {
          colours.map((t) => (
            <li>
              <span class="chip" style={`background: var(--${t})`} />
              <code>--{t}</code>
              <span class="muted">{tokens[t]}</span>
              {evidence(t) && (
                <span class="muted small" title={evidence(t)!.source}>
                  {evidence(t)!.value.toUpperCase() === tokens[t].toUpperCase() ? evidence(t)!.confidence : 'changed after capture'}
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <table>
        <caption class="muted">Contrast pairs the build checks</caption>
        <thead><tr><th scope="col">Pair</th><th scope="col">Ratio</th><th scope="col">Result</th></tr></thead>
        <tbody>
          {contrastResults.map((r) => <tr><td>{r.label}</td><td>{r.ratio.toFixed(2)}</td><td>{r.pass ? 'Pass' : 'Fail'}</td></tr>)}
        </tbody>
      </table>
    </section>

    <section aria-labelledby="type">
      <h2 id="type">Type</h2>
      <p class="specimen-hero">Display, hero size</p>
      <p class="specimen-heading">Display, heading size</p>
      <p>Body: {tokens['font-body'].split(',')[0].replace(/['"]/g, '')} at {tokens['size-body']}</p>
      <p class="muted small">Small and muted, for captions and labels</p>
    </section>

    <section aria-labelledby="actions">
      <h2 id="actions">Actions</h2>
      {content.hero?.cta && <a class="button" href={`/${brand.id}/${target}`}>{content.hero.cta}</a>}
      {flow && <p>First ask: "{action}", a one-tap question in the hero.</p>}
      <p class="muted small">
        One ask per page. Every button points to the {flow ? 'question flow' : 'capture form'}. First ask: {guide.firstAsk}
      </p>
    </section>

    <section aria-labelledby="sections">
      <h2 id="sections">Conversion sections, in order</h2>
      <ol class="sections">
        {
          recipes[recipe].map((id) => {
            const spec = sections[id];
            const refs = references.filter((r) => spec.referenceIds.includes(r.id));
            return (
              <li>
                <strong>{spec.name}</strong> <span class="role">{spec.role}</span> <span class="role">{spec.stage}</span>
                {variants[id] && <span class="muted"> · variant: {variants[id]}</span>}
                <p class="muted">{spec.job}</p>
                <p class="muted small">
                  References: {refs.length ? refs.map((r) => r.data.name).join(', ') : 'none linked yet'}
                </p>
              </li>
            );
          })
        }
      </ol>
    </section>
  </main>
</Base>

<style>
  .sheet {
    padding-block: var(--space-section);
    display: grid;
    gap: var(--space-section);
  }
  h1 {
    font-size: var(--size-hero);
    margin-block: 0.5rem 1rem;
  }
  h2 {
    font-size: var(--size-heading);
    margin-bottom: var(--space-block);
  }
  a:not(.button) {
    color: inherit;
  }
  .small {
    font-size: var(--size-small);
    margin-top: 0.75rem;
  }
  .checks,
  .swatches {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .swatches {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin-bottom: var(--space-block);
  }
  .swatches li {
    display: grid;
    gap: 0.25rem;
  }
  .chip {
    height: 4rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }
  code {
    font-size: var(--size-small);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-small);
  }
  caption {
    text-align: left;
    padding-bottom: 0.5rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .specimen-hero {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--size-hero);
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .specimen-heading {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--size-heading);
    margin-bottom: 1rem;
  }
  .strategy {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1rem 2rem;
  }
  .strategy dd {
    margin: 0.25rem 0 0;
  }
  .strategy .small {
    margin-top: 0;
  }
  .subhead {
    font-size: 1.25em;
    margin: var(--space-block) 0 0.75rem;
  }
  /* Grid items default to min-width: auto, so a wide table would widen the page. Let them shrink. */
  .sheet > * {
    min-width: 0;
  }
  .table-wrap {
    overflow-x: auto;
    margin-bottom: var(--space-block);
  }
  .table-wrap td {
    vertical-align: top;
    min-width: 10rem;
  }
  .pass-facts ol,
  .pass-facts ul {
    margin: 0.25rem 0 0;
    padding-left: 1.25rem;
  }
  .answer {
    margin-top: 0.25rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-border);
    color: var(--color-muted);
  }
  .designer {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    max-width: 52rem;
  }
  .sections {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 1.25rem;
  }
  .role {
    font-size: var(--size-small);
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
</style>
