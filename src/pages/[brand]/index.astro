---
// A client's funnel page. This file never changes per client: it reads the brand file,
// checks it, and assembles sections in recipe order. Every button points at the one ask.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../sections/Hero.astro';
import Flow from '../../sections/Flow.astro';
import Video from '../../sections/Video.astro';
import Benefits from '../../sections/Benefits.astro';
import Offer from '../../sections/Offer.astro';
import Story from '../../sections/Story.astro';
import Proof from '../../sections/Proof.astro';
import Agenda from '../../sections/Agenda.astro';
import Faq from '../../sections/Faq.astro';
import Capture from '../../sections/Capture.astro';
import Cta from '../../sections/Cta.astro';
import { recipes, usesFlow } from '../../system/sections';
import { assertBrandPasses, assertImagesExist } from '../../system/rules';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((brand) => ({ params: { brand: brand.id }, props: { brand } }));
}

const { brand } = Astro.props as { brand: CollectionEntry<'brands'> };
const { tokens, content: c, layout, seo, fontsHref, recipe, logo } = brand.data;
assertBrandPasses(brand.id, tokens);
// The build runs from the project root, so public/ resolves from there.
assertImagesExist(brand.id, brand.data, 'public');

// The schema guarantees every section in the recipe has content, so the ! below is safe.
const target = usesFlow(recipe) ? '#flow' : '#capture';
---

<Base title={seo.title} description={seo.description} tokens={tokens} fontsHref={fontsHref}>
  <main data-funnel-brand={brand.id} data-funnel-recipe={recipe}>
    {
      recipes[recipe].map((id) => {
        switch (id) {
          case 'hero':
            return (
              <Hero content={c.hero!} variant={layout.hero!} target={target} logo={logo}>
                {layout.hero === 'question' && <Flow content={c.flow!} />}
              </Hero>
            );
          case 'flow':
            // Rendered inside the hero: the first ask is a tap on the first screen.
            return null;
          case 'video':
            return <Video content={c.video!} target={target} />;
          case 'benefits':
            return <Benefits content={c.benefits!} variant={layout.benefits!} />;
          case 'offer':
            return <Offer content={c.offer!} variant={layout.offer!} />;
          case 'story':
            return <Story content={c.story!} />;
          case 'proof':
            return <Proof content={c.proof!} />;
          case 'agenda':
            return <Agenda content={c.agenda!} />;
          case 'faq':
            return <Faq content={c.faq!} />;
          case 'capture':
            return <Capture content={c.capture!} />;
          case 'cta':
            return <Cta content={c.cta!} target={target} />;
        }
      })
    }
  </main>
</Base>

<script>
  import { isCtaLocation, track } from '../../system/events';
  track('funnel_viewed', {});

  // Buttons that jump to the ask carry data-cta, naming where they sit on the page.
  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-cta]') : null;
    const location = button?.dataset.cta;
    if (isCtaLocation(location)) track('cta_clicked', { location });
  });
</script>
