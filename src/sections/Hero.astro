---
// The hook. "question" replaces the button with the first step of the question flow,
// passed in as a slot, so the first ask is a tap rather than a form.
interface Props {
  content: { eyebrow: string; headline: string; subhead: string; cta?: string };
  variant: 'stacked' | 'split' | 'question';
  target: string;
}
const { content, variant, target } = Astro.props;
const { eyebrow, headline, subhead, cta } = content;
---

<header class={`section hero ${variant}`}>
  <div class="container layout">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{headline}</h1>
    </div>
    <div>
      <p class="subhead muted">{subhead}</p>
      {variant === 'question' ? <slot /> : <a class="button" href={target}>{cta}</a>}
    </div>
  </div>
</header>

<style>
  .split .layout {
    display: grid;
    gap: 1rem 3rem;
    align-items: end;
  }
  @media (min-width: 52rem) {
    .split .layout {
      grid-template-columns: 1.4fr 1fr;
    }
    .split h1 {
      margin-bottom: 0;
    }
  }
  .hero h1 {
    font-size: var(--size-hero);
    max-width: 16ch;
    margin-block: 1rem 1.25rem;
  }
  /* Narrow column for the question, left edge aligned with the sections below. */
  .question .layout > div {
    max-width: 40rem;
  }
  .question h1 {
    max-width: 20ch;
  }
  .subhead {
    max-width: 52ch;
    margin-bottom: 2rem;
    font-size: 1.125em;
  }
  .question .subhead {
    margin-bottom: 1.5rem;
  }
</style>
