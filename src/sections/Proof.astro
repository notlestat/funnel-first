---
import type { BrandImage } from '../system/schema';

interface Pair {
  before: BrandImage;
  after: BrandImage;
  caption: string;
  placeholder: boolean;
}
interface Props {
  content: { heading: string; quotes: { quote: string; source: string; placeholder: boolean }[]; pairs?: Pair[] };
}
const { heading, quotes, pairs = [] } = Astro.props.content;
const sides = (p: Pair) => [
  { label: 'Before', img: p.before },
  { label: 'After', img: p.after },
];
---

<section class="section" aria-labelledby="proof-heading">
  <div class="container">
    <h2 id="proof-heading" class="section-heading">{heading}</h2>
    {
      pairs.map((p) => (
        <figure class:list={['pair', { placeholder: p.placeholder }]}>
          {p.placeholder && <p class="flag">Placeholder: the client needs to confirm these photos</p>}
          <div class="sides">
            {sides(p).map(({ label, img }) => (
              <div>
                <p class="side-label">{label}</p>
                <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
          <figcaption class="muted">{p.caption}</figcaption>
        </figure>
      ))
    }
    <div class="quotes">
      {
        quotes.map((q) => (
          <figure class:list={['quote', { placeholder: q.placeholder }]}>
            {q.placeholder && <p class="flag">Placeholder: the client needs to supply this</p>}
            <blockquote>{q.quote}</blockquote>
            <figcaption class="muted">{q.source}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pair {
    margin: 0 0 calc(var(--space-block) * 1.5);
  }
  .sides {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .sides img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .side-label {
    margin-bottom: 0.375rem;
    font-size: var(--size-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pair figcaption {
    margin-top: 0.75rem;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }
  .quote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-accent);
  }
  blockquote {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.25em;
    line-height: 1.35;
  }
  figcaption {
    font-size: var(--size-small);
  }
  .placeholder {
    border-left-style: dashed;
  }
  .flag {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--color-muted);
    font-size: var(--size-small);
    color: var(--color-muted);
  }
</style>
